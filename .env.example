# Copy to .env and fill in real values:  cp .env.example .env
# .env is git-ignored; this example file is committed so everyone knows which variables exist.

# Brave Search API key, used by `python -m jobpipe.discover` (https://brave.com/search/api/)
BRAVE_API_KEY=

# Anthropic API key, used by `python -m jobpipe.audit_skills` (https://console.anthropic.com/)
ANTHROPIC_API_KEY=

# Optional DuckDB resource limits for `dbt build` (ADR-021). Not secrets; the
# defaults (4 threads, 3GB) suit a 16-core / 8 GB laptop. Raise them on a
# bigger machine.
# JOBPIPE_DUCKDB_THREADS=4
# JOBPIPE_DUCKDB_MEMORY=3GB

# S3 upload of the raw layer (ADR-030, ADR-032). Leave JOBPIPE_S3_BUCKET empty
# to skip the upload (the Airflow task then shows as "skipped").
# Values come from `terraform output` in infra/terraform/main; the key belongs
# to the jobpipe-pipeline IAM user (aws iam create-access-key), not to you.
JOBPIPE_S3_BUCKET=
AWS_REGION=us-east-2
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Optional: make dbt read the raw layer from S3 instead of data/raw (ADR-031).
# dbt doesn't read .env, so export it in the shell: set -a; . ./.env; set +a
# JOBPIPE_RAW_ROOT=s3://<bucket>/raw
